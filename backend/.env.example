# AutoSecAI Backend Environment Variables
GITHUB_TOKEN=ghp_your_github_token_here
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=groq/compound-mini
FRONTEND_URL=http://localhost:5173

# Optional: GitHub OAuth Settings (for direct Sign In with GitHub)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: PostgreSQL Connection String (defaults to SQLite if empty)
# DATABASE_URL=postgresql://user:password@localhost:5432/autosecai
